# Stage 1 — Django collectstatic
FROM python:3.11-slim AS staticfiles
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
RUN SECRET_KEY=build-only python manage.py collectstatic --noinput

# Stage 2 — React build
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --silent
COPY frontend/ .
ARG VITE_API_URL=https://fincalc.abastolink.cloud/api
RUN VITE_API_URL=${VITE_API_URL} npm run build

# Stage 3 — nginx serving SPA + static files
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=staticfiles /app/staticfiles /usr/share/nginx/html/static
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
